{
  "account_id": "4bd923873cefb96a0ce4ac36e55f156b",
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motion-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // Set to the deployed Render service before `wrangler deploy` (not a secret).
    // Local development overrides it from .dev.vars (see .dev.vars.example).
    "RENDER_API_URL": "https://construction-safety-model-api.onrender.com"
  },
  // Saved analysis summaries (never video or raw keypoints). One binding for local dev and production:
  // `npm run dev` and `wrangler d1 ... --local` use a local SQLite copy under .wrangler/state;
  // `wrangler deploy` and `--remote` use the Cloudflare database with this database_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motion-atlas-history",
      // Replace with the ID printed by `npx wrangler d1 create motion-atlas-history` (see README).
      // Local development works with the placeholder; deploying with it fails.
      "database_id": "b9892519-661f-4d44-958a-c114541e7a9d",
      "migrations_dir": "migrations"
    }
  ]
}
